rules_version = '2';

// Baseline rules: only signed-in users can read or write.
// The app currently writes across users (link requests, mirrored chats,
// notifications) and the guardian map reads the Child collection, so
// per-user rules come later, after those queries are fixed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
